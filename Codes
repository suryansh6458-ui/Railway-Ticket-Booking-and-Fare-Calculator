
bookings = []
booking_id = 1001

while True:
    print("\n===== RAILWAY TICKET SYSTEM =====")
    print("1. Book Ticket")
    print("2. View All Bookings")
    print("3. Search Booking")
    print("4. Cancel Booking")
    print("5. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        name = input("Passenger name: ")
        age = int(input("Passenger age: "))

        print("\n1. Sleeper - Rs. 200")
        print("2. AC 3 Tier - Rs. 600")
        print("3. AC 2 Tier - Rs. 900")

        seat = input("Choose class: ")

        if seat == "1":
            ticket_class = "Sleeper"
            fare = 200
        elif seat == "2":
            ticket_class = "AC 3 Tier"
            fare = 600
        elif seat == "3":
            ticket_class = "AC 2 Tier"
            fare = 900
        else:
            print("Invalid class!")
            continue

        if age < 5:
            fare = 0
        elif age <= 12:
            fare = fare * 0.5

        booking = {
            "id": booking_id,
            "name": name,
            "age": age,
            "class": ticket_class,
            "fare": fare
        }

        bookings.append(booking)

        print("\nTicket booked successfully!")
        print("Booking ID:", booking_id)
        print("Fare: Rs.", fare)

        booking_id += 1

    elif choice == "2":
        if len(bookings) == 0:
            print("No bookings available.")
        else:
            for b in bookings:
                print("\nBooking ID:", b["id"])
                print("Name:", b["name"])
                print("Age:", b["age"])
                print("Class:", b["class"])
                print("Fare: Rs.", b["fare"])

    elif choice == "3":
        search_id = int(input("Enter booking ID: "))
        found = False

        for b in bookings:
            if b["id"] == search_id:
                print("Passenger:", b["name"])
                print("Class:", b["class"])
                print("Fare: Rs.", b["fare"])
                found = True

        if found == False:
            print("Booking not found.")

    elif choice == "4":
        cancel_id = int(input("Enter booking ID to cancel: "))
        found = False

        for b in bookings:
            if b["id"] == cancel_id:
                bookings.remove(b)
                print("Booking cancelled.")
                found = True
                break

        if found == False:
            print("Booking not found.")

    elif choice == "5":
        print("Thank you for using Railway Ticket System!")
        break

    else:
        print("Invalid choice!")
